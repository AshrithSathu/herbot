# Copy to .env for local runs. Never commit .env.
DATABASE_URL=postgres://herbot:herbot@127.0.0.1:5433/herbot
HERBOT_BIND=127.0.0.1:8787
HERBOT_LOG_FORMAT=pretty
RUST_LOG=info,herbot_core=debug

# Telegram (Step 2). Leave the token empty to run without Telegram.
TELEGRAM_BOT_TOKEN=
# Your own Telegram user ID: the only account the bot ever answers.
HERBOT_ADMIN_TELEGRAM_ID=
# Optional: lock Herbot to one group (negative ID, e.g. -1004447072305). Empty = any group you add it to.
HERBOT_HOME_CHAT_ID=

# OpenAI: voice notes in (transcription) and spoken replies out (speech).
OPENAI_API_KEY=
# HERBOT_TRANSCRIBE_MODEL=gpt-transcribe
# HERBOT_TTS_MODEL=gpt-4o-mini-tts

# Scheduled tasks: the timezone for "every morning" and friends.
# HERBOT_TIMEZONE=Asia/Kolkata

# Agent tools, admin panel and simulation.
HERBOT_INTERNAL_TOKEN=
HERBOT_ADMIN_TOKEN=
HERBOT_SESSION_SECRET=
HERBOT_ADMIN_PASSWORD=
# Only for running Herbot without Telegram at hand: POST /internal/simulate
# injects admin messages. Never in production.
# HERBOT_SIMULATE=1
